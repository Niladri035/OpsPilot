# ============================================================
# OpsPilot — Root .gitignore
# ============================================================

# ─── Node / npm ─────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.pnp
.pnp.*

# ─── Next.js ────────────────────────────────────────────────
web/.next/
web/out/
web/build/
web/.vercel
web/next-env.d.ts
web/*.tsbuildinfo

# ─── Prisma generated client ────────────────────────────────
web/src/generated/

# ─── Environment & Secrets ──────────────────────────────────
.env
.env.*
!.env.example

# ─── Docker ─────────────────────────────────────────────────
.docker/

# ─── OS Files ───────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─── IDE / Editor ───────────────────────────────────────────
.vscode/
.idea/
*.swp
*~

# ─── Logs & Coverage ────────────────────────────────────────
logs/
*.log
coverage/

# ─── Certificates ───────────────────────────────────────────
*.pem
*.key
*.cert
